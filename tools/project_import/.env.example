# ============================================================
#  batch-link-import 配置示例
#  复制本文件为 .env 后填入你自己的值（.env 已被 .gitignore 忽略，不会上传）
#  所有变量均可选；标「必填」的除外。
# ============================================================

# ---------- 飞书多维表格（必填：结果写到哪张表） ----------
# 方式 A：直接填 Base Token + Table ID
# FEISHU_BASE_TOKEN=你的_Base_Token
# FEISHU_TABLE_ID=你的_Table_ID
#
# 方式 B：填飞书 Wiki / 文档链接，工具会自动解析成 Base Token + Table ID
#         （从链接的 ?table= 参数读取表，无需再填 FEISHU_TABLE_ID）
#         例：https://xxx.feishu.cn/wiki/xxxx?table=tblXXXX&view=vewXXXX
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=

# 字段映射（可选）：默认读项目根目录 feishu_fields.json；
# 也可用此环境变量整体覆盖，值为 JSON 字符串（逻辑字段名 -> 飞书列 id）
# FEISHU_FIELD_MAP={"project_name":"fldXXX","summary":"fldYYY", ...}

# ---------- LLM 分析（全自动模式必填；不填则退回手动/交互） ----------
# 任意 OpenAI 兼容接口。国内可用 DeepSeek / 通义千问 / 硅基流动 等
# BATCH_LLM_API_KEY=sk-xxxxxxxx
# BATCH_LLM_BASE_URL=https://api.openai.com/v1
# BATCH_LLM_MODEL=gpt-4o-mini
#
# 离线模式：把分析结果预先存成 JSON 文件，用 --analysis-file 指定，跳过实时调用
# BATCH_LLM_ANALYSIS_FILE=analysis.json

# ---------- GitHub / Gitee 限流（可选） ----------
# 匿名 60 次/小时；填 Token 提到 5000 次/小时。少量导入（几次~二十几个）可不填。
GITHUB_TOKEN=
GITEE_TOKEN=

# ---------- 并发（可选） ----------
# 采集 + 分析阶段并行的工作线程数，默认 5，不会超过待处理仓库数量
BATCH_MAX_WORKERS=5
