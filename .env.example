# ===========================================
# AI Provider 配置
# ===========================================
# 指定使用的 AI Provider（留空则自动检测可用 Provider）
# 可选值：trae, openai, anthropic, google, local, mock
# AI_PROVIDER=trae

# OpenAI API 配置
# 获取地址：https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxx
# 可选，自定义模型，默认 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API 配置
# 获取地址：https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxxx
# 可选，自定义模型，默认 claude-sonnet-4-20250514
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini API 配置
# 获取地址：https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=xxxx
# 可选，自定义模型，默认 gemini-2.0-flash
# GOOGLE_MODEL=gemini-2.0-flash

# 本地模型配置（Ollama、LM Studio 等）
# Ollama 默认地址：http://localhost:11434/v1
# LOCAL_API_BASE=http://localhost:11434/v1
# 可选，自定义模型，默认 llama3
# LOCAL_MODEL=llama3

# ===========================================
# 输出目标配置
# ===========================================

# Obsidian 知识库路径（可选）
# OBSIDIAN_VAULT_PATH=D:\你的Obsidian库路径

# 飞书知识库空间 ID（可选）
# FEISHU_WIKI_SPACE=你的知识库空间ID

# 飞书知识库父节点 Token（可选）
# FEISHU_WIKI_PARENT_NODE=父节点Token

# ===========================================
# 质量闸门（可选 · 默认关闭）
# ===========================================
# 质量闸门：总结后由 AI 做第二遍审核（6 红线打 0–100 分），
# 低于阈值则带反馈重试一次。默认关闭（省一轮 AI 调用）。
# 想开启：取消下面一行注释，置 1；阈值可另设（默认 85）。
# NOTE_QUALITY_GATE=1
# NOTE_GATE_THRESHOLD=85

# ===========================================
# Provider 自动检测优先级（自动总结用）
# ===========================================
# 1. 优先使用 AI_PROVIDER 环境变量指定的外部 Provider
# 2. 按以下顺序自动选择第一个可用的：
#    openai > anthropic > google > local
# 3. Trae SDK 不参与自动检测，归入降级流程由外层对话接手
# 4. 设置 AI_PROVIDER=trae 可强制使用 Trae SDK 子会话总结

# ===========================================
# 订阅监控（B站 / 公众号，可选）
# ===========================================
# 详见 references/config.md 第十节 与 monitors/README.md。
# B站登录态 Cookie（动态接口硬性要求；F12→Application→Cookie 复制整段）。
# 缺失则降级游客态并告警，视频偶发 -352 且动态无法抓取。
# BILI_COOKIE=

# 频率（秒）：跨源退避（run.py 额外加 ±5s 抖动）；同源视频→动态退避；重试退避基数
# BILI_GAP=30
# BILI_INTRA_GAP=2
# BILI_BACKOFF=5

# 时间窗口（天）：首跑回填 / 每日增量。只处理窗口内发布的视频与动态
# BILI_FIRST_WINDOW_DAYS=7
# BILI_DAILY_WINDOW_DAYS=1

# 单页拉取条数 / 短动态轻量化阈值（字）/ 首跑每类型安全上限 / 每源去重上限
# BILI_PAGE_SIZE=50
# BILI_SHORT_DYNAMIC_MAX=80
# FIRST_RUN_LIMIT=50
# STATE_KEEP=1000

