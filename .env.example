# ===========================================
# 总结模式配置（已废弃外部 AI Provider）
# ===========================================
# 本项目统一由 WorkBuddy 执行模型（主 Agent / 子 Agent）完成总结，
# 不再调用外部 OpenAI/Anthropic/Google/Local 等 Provider。
# 如需临时恢复旧行为（不建议），可取消下面 AI Provider 区注释并配 key。
FORCE_AGENT_MODE=1

# ===========================================
# [已废弃] 外部 AI Provider 配置区
# ===========================================
# 以下外部 Provider 配置仅在 FORCE_AGENT_MODE=0 时生效；
# 默认 FORCE_AGENT_MODE=1，因此本节保持注释即可。
# AI_PROVIDER=trae
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GOOGLE_API_KEY=xxxx
# GOOGLE_MODEL=gemini-2.0-flash
# LOCAL_API_BASE=http://localhost:11434/v1
# LOCAL_MODEL=llama3

# ===========================================
# 输出目标配置
# ===========================================

# Obsidian 知识库路径（可选）
# OBSIDIAN_VAULT_PATH=D:\你的Obsidian库路径

# 飞书知识库空间 ID（可选）
# FEISHU_WIKI_SPACE=你的知识库空间ID

# 飞书知识库父节点 Token（可选）
# FEISHU_WIKI_PARENT_NODE=父节点Token

# ===========================================
# 质量闸门（可选 · 默认关闭）
# ===========================================
# 质量闸门：总结后由 AI 做第二遍审核（6 红线打 0–100 分），
# 低于阈值则带反馈重试一次。默认关闭（省一轮 AI 调用）。
# 想开启：取消下面一行注释，置 1；阈值可另设（默认 85）。
# NOTE_QUALITY_GATE=1
# NOTE_GATE_THRESHOLD=85

# ===========================================
# Provider 自动检测优先级（自动总结用）
# ===========================================
# 1. 优先使用 AI_PROVIDER 环境变量指定的外部 Provider
# 2. 按以下顺序自动选择第一个可用的：
#    openai > anthropic > google > local
# 3. Trae SDK 不参与自动检测，归入降级流程由外层对话接手
# 4. 设置 AI_PROVIDER=trae 可强制使用 Trae SDK 子会话总结

# ===========================================
# 订阅监控（B站 / 公众号，可选）
# ===========================================
# 详见 references/config.md 第十节 与 monitors/README.md。
# B站登录态 Cookie（动态接口硬性要求；F12→Application→Cookie 复制整段）。
# 缺失则降级游客态并告警，视频偶发 -352 且动态无法抓取。
# BILI_COOKIE=

# 频率（秒）：跨源退避（run.py 额外加 ±5s 抖动）；同源视频→动态退避；重试退避基数
# BILI_GAP=30
# BILI_INTRA_GAP=2
# BILI_BACKOFF=5

# 时间窗口（天）：首跑回填 / 每日增量。只处理窗口内发布的视频与动态
# BILI_FIRST_WINDOW_DAYS=30
# BILI_DAILY_WINDOW_DAYS=1

# 单页拉取条数 / 短动态轻量化阈值（字）/ 首跑每类型安全上限 / 每源去重上限
# BILI_PAGE_SIZE=50
# BILI_SHORT_DYNAMIC_MAX=80
# FIRST_RUN_LIMIT=50
# STATE_KEEP=1000

# 公众号（weread 代理）配置
# 时间窗口（天）：只保留最近 N 天发布的文章，不深挖历史；设为 0 抓全部最新 N 篇
# WECHAT_WINDOW_DAYS=2
# 公众号逐篇抓正文间隔（秒，+0~3s 抖动）：无间隔连抓会被微信限流返空页，硬保护勿调 0
# WECHAT_GAP=6
# 正文短于此值视为「限流空页/无正文」，进重试队列下次重抓
# WECHAT_MIN_CONTENT_LEN=100
# discover 空轮重试：token 有效但代理返空列表（冷启动/懒加载未预热）时退避重试次数；
# 仅「原始列表真为空」才重试，列表非空但全被 seen 过滤属正常不重试
# WECHAT_EMPTY_RETRIES=3
# 墙文/已删除/持续限流：连续抓取正文为空达到此次数，判定「不可抓取」，移出重试队列并明确
# 上报（不再无限重试刷虚假告警）。微信扫码墙 trafilatura 会抽到 UI 壳文本（>阈值）骗过长度闸门，
# fetch.py 已加墙标记识别；此参数控制重试容忍度，调小可更快移除墙文、调大更宽容限流
# WECHAT_MAX_REFETCH=3

